rules_version = '2';

// =====================================================================
// ProtecBag — Regras de segurança do Firestore
//
// Modelo:
//  - Login pelo Firebase Authentication com E-mail e Senha.
//  - O perfil de cada pessoa fica em /users/{email-em-minúsculas} e guarda
//    o papel (role), a franquia e o authUid da conta no Firebase Auth.
//  - Usuários criados diretamente no Firebase têm acesso garantido como Admin.
//  - Nenhuma senha é guardada no Firestore.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() == 'thetoic@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }

    function me() {
      return get(profilePath()).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(profilePath())
        && me().get('authUid', '') == request.auth.uid
        && me().get('active', true) == true;
    }

    function isRole(r) {
      return hasProfile() && me().role == r;
    }

    function isGlobalAdmin() {
      return isOwner() || isRole('admin');
    }

    function isFranchiseAdmin() {
      return isRole('admin_franquia') && me().franchise.size() > 0;
    }

    // Admin de franquia com franquia "CWB" enxerga a base inteira (region == CWB);
    // com franquia "CWB01" enxerga somente aquela unidade.
    function inAdminScope(d) {
      return isGlobalAdmin()
        || (isFranchiseAdmin()
            && (d.get('region', '') == me().franchise || d.get('franchise', '') == me().franchise));
    }

    function isLowRole(r) {
      return r in ['colaborador', 'usuario_normal'];
    }

    // ---------- Validações ----------
    function validUser(d, key) {
      return d.keys().hasAll(['id', 'name', 'email', 'role', 'franchise', 'region', 'authUid'])
        && !('password' in d)
        && d.email == key
        && d.role in ['admin', 'admin_franquia', 'colaborador', 'usuario_normal']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.franchise is string && d.region is string;
    }

    function validBilling(d, id) {
      return d.id == id
        && d.franchise is string && d.franchise.size() > 0
        && d.region is string && d.franchise.matches(d.region + '.*')
        && d.status in ['Pendente', 'Aprovado', 'Rejeitado']
        && d.shift in ['Manhã', 'Tarde', 'Noite']
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.totalAmount is number;
    }

    // ---------- Bloqueio padrão ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Usuários ----------
    match /users/{key} {
      // Qualquer pessoa logada pode ler o PRÓPRIO perfil (sem segredos).
      allow get: if signedIn() && (key == myEmail() || resource.data.authUid == request.auth.uid);

      // Administradores leem os perfis dentro do seu escopo, ou o usuário lê caso seja seu próprio e-mail
      allow read: if inAdminScope(resource.data) || (signedIn() && (key == myEmail() || resource.data.email == myEmail()));

      // Permite criar o próprio perfil no primeiro acesso (qualquer usuário autenticado via Firebase Auth) OU criação por admin
      allow create: if (
        (signedIn() && (key == myEmail() || request.resource.data.email == myEmail()) && request.resource.data.authUid == request.auth.uid)
        || (validUser(request.resource.data, key) && isGlobalAdmin())
        || (validUser(request.resource.data, key) && isFranchiseAdmin()
            && inAdminScope(request.resource.data)
            && isLowRole(request.resource.data.role))
      );

      // Permite atualizar o próprio perfil (ex: vincular authUid) OU por administrador
      allow update: if (
        (signedIn() && (key == myEmail() || resource.data.email == myEmail()) && request.resource.data.authUid == request.auth.uid)
        || (isGlobalAdmin() && validUser(request.resource.data, key))
        || (isFranchiseAdmin()
            && validUser(request.resource.data, key)
            && inAdminScope(resource.data) && isLowRole(resource.data.role)
            && inAdminScope(request.resource.data) && isLowRole(request.resource.data.role)
            && request.resource.data.authUid == resource.data.authUid)
      );

      allow delete: if isGlobalAdmin()
        || (isFranchiseAdmin() && inAdminScope(resource.data) && isLowRole(resource.data.role));
    }

    // ---------- Faturamentos ----------
    match /billings/{billingId} {
      allow read: if inAdminScope(resource.data)
        || (isRole('colaborador') && resource.data.collaboratorId == me().id)
        || (isRole('usuario_normal') && resource.data.franchise == me().franchise);

      allow create: if validBilling(request.resource.data, billingId) && (
        inAdminScope(request.resource.data)
        || (isRole('colaborador')
            && request.resource.data.collaboratorId == me().id
            && request.resource.data.franchise == me().franchise
            && request.resource.data.status == 'Pendente'
            && !request.resource.data.keys().hasAny(['auditedBy', 'auditedAt']))
      );

      allow update: if inAdminScope(resource.data)
        && inAdminScope(request.resource.data)
        && validBilling(request.resource.data, billingId);

      allow delete: if inAdminScope(resource.data);
    }
  }
}
